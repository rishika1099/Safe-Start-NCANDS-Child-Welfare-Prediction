  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## SECTION 1.5 — Missing Data Handling in R\n",
    "\n",
    "Three strategies depending on WHY data is missing:\n",
    "1. **Structural** → sentinel value (days_since_last_report)\n",
    "2. **MAR** → impute + create missingness indicator (substance_use_flag)\n",
    "3. **Informative** → keep NA as a factor level"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# STRATEGY 1: Structural missingness → sentinel value\n",
    "# days_since_last_report is NA because there's no prior report\n",
    "# -1 is a sentinel saying 'no prior report existed'\n",
    "\n",
    "features_clean <- features %>%\n",
    "  mutate(\n",
    "    has_prior_report       = prior_reports_12mo > 0,\n",
    "    days_since_last_report = replace_na(days_since_last_report, -1)\n",
    "  )\n",
    "\n",
    "# Verify: when has_prior_report is FALSE, days should all be -1\n",
    "features_clean %>%\n",
    "  group_by(has_prior_report) %>%\n",
    "  summarise(\n",
    "    n              = n(),\n",
    "    min_days       = min(days_since_last_report),\n",
    "    max_days       = max(days_since_last_report)\n",
    "  )"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# STRATEGY 2: MAR missingness → impute + indicator\n",
    "# substance_use_flag: missing because caseworker didn't document\n",
    "# Create indicator BEFORE imputing (otherwise you lose the signal)\n",
    "\n",
    "features_clean <- features_clean %>%\n",
    "  mutate(\n",
    "    # Step 1: Create indicator FIRST\n",
    "    substance_flag_missing = is.na(substance_use_flag),\n",
    "\n",
    "    # Step 2: Impute with mode (most common value)\n",
    "    substance_use_flag = coalesce(\n",
    "      substance_use_flag,\n",
    "      as.numeric(names(which.max(table(substance_use_flag, useNA='no'))))\n",
    "    )\n",
    "  )\n",
    "\n",
    "# Verify\n",
    "cat('substance_flag_missing created:', sum(features_clean$substance_flag_missing), 'cases\\n')\n",
    "cat('substance_use_flag NAs remaining:', sum(is.na(features_clean$substance_use_flag)), '\\n')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# STRATEGY 3: Check if missingness correlates with other variables\n",
    "# If substance_flag_missing correlates with caseworker_caseload\n",
    "# that confirms it's MAR (not MCAR) and the indicator has real signal\n",
    "\n",
    "features_clean %>%\n",
    "  group_by(substance_flag_missing) %>%\n",
    "  summarise(\n",
    "    n                   = n(),\n",
    "    avg_caseload        = round(mean(caseworker_caseload), 1),\n",
    "    avg_prior_reports   = round(mean(prior_reports_12mo), 2),\n",
    "    avg_consultation    = round(mean(needs_investigative_consultation, na.rm=TRUE), 3)\n",
    "  )\n",
    "\n",
    "# WHAT TO LOOK FOR:\n",
    "# If avg_caseload is HIGHER when substance_flag_missing=TRUE\n",
    "# → confirms: busy caseworkers skip this field more\n",
    "# → the missingness indicator is a real signal about documentation quality\n",
    "# If avg_consultation is DIFFERENT between groups\n",
    "# → even more reason to keep the indicator as a feature"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# FINAL CLEAN FEATURE TABLE\n",
    "# Apply all transformations, verify zero remaining NAs in model features\n",
    "\n",
    "features_final <- features_clean %>%\n",
    "  mutate(\n",
    "    # Contact missingness indicator + imputation\n",
    "    contact_missing        = is.na(days_to_first_contact),\n",
    "    days_to_first_contact  = replace_na(days_to_first_contact,\n",
    "                                         median(days_to_first_contact, na.rm=TRUE)),\n",
    "\n",
    "    # Engineered interaction features\n",
    "    high_caseload          = caseworker_caseload > 60,\n",
    "    multi_child_young      = n_children_in_household >= 3 & child_age_under_5 == 1,\n",
    "    compounded_risk        = dv_history_flag + shelter_involvement_flag + prior_substantiated_flag\n",
    "  )\n",
    "\n",
    "# Verify no NAs in model columns\n",
    "model_cols <- c('prior_reports_12mo','prior_substantiated_flag','days_since_last_report',\n",
    "                'has_prior_report','n_children_in_household','child_age_under_5',\n",
    "                'dv_history_flag','substance_use_flag','substance_flag_missing',\n",
    "                'shelter_involvement_flag','days_to_first_contact','contact_missing',\n",
    "                'reporter_accuracy_score','caseworker_caseload','high_caseload',\n",
    "                'multi_child_young','compounded_risk')\n",
    "\n",
    "na_check <- features_final %>%\n",
    "  select(all_of(model_cols)) %>%\n",
    "  summarise(across(everything(), ~ sum(is.na(.)))) %>%\n",
    "  pivot_longer(everything(), names_to='col', values_to='n_missing') %>%\n",
    "  filter(n_missing > 0)\n",
    "\n",
    "if(nrow(na_check) == 0) {\n",
    "  cat('✓ Zero NAs remaining in all model features\\n')\n",
    "} else {\n",
    "  cat('⚠️ Still have NAs in:', paste(na_check$col, collapse=', '), '\\n')\n",
    "}\n",
    "\n",
    "cat('Final feature table:', nrow(features_final), 'rows x', ncol(features_final), 'cols\\n')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## SECTION 1.6 — R Shiny: Your First Interactive Dashboard\n",
    "\n",
    "Shiny apps have two parts:\n",
    "- **UI**: what the user sees (inputs + outputs)\n",
    "- **Server**: the R code that runs when inputs change\n",
    "\n",
    "Run the code below in a fresh R session (not Colab) or use shinyapps.io.  \n",
    "In Colab: copy to a .R file and run with `shiny::runApp()`"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# SAVE THIS AS: acs_dashboard.R\n",
    "# Then run: shiny::runApp('acs_dashboard.R')\n",
    "\n",
    "shiny_app_code <- '\n",
    "library(shiny)\n",
    "library(tidyverse)\n",
    "library(shinydashboard)\n",
    "\n",
    "# Load data\n",
    "scr <- read_csv(\"acs_scr_reports.csv\", show_col_types=FALSE) %>%\n",
    "  mutate(\n",
    "    report_date      = as.Date(report_date),\n",
    "    is_substantiated = outcome == \"Substantiated\",\n",
    "    year_month       = floor_date(report_date, \"month\")\n",
    "  )\n",
    "\n",
    "# ─── UI ───────────────────────────────────────────────────────\n",
    "ui <- dashboardPage(\n",
    "  dashboardHeader(title = \"ACS ChildStat Dashboard\"),\n",
    "\n",
    "  dashboardSidebar(\n",
    "    sidebarMenu(\n",
    "      menuItem(\"Borough Analysis\",  tabName=\"borough\",  icon=icon(\"map\")),\n",
    "      menuItem(\"Reporter Analysis\", tabName=\"reporter\", icon=icon(\"phone\")),\n",
    "      menuItem(\"Trends\",            tabName=\"trends\",   icon=icon(\"chart-line\"))\n",
    "    ),\n",
    "\n",
    "    # Filters that apply across all tabs\n",
    "    selectInput(\"borough_filter\", \"Filter by Borough:\",\n",
    "      choices  = c(\"All\", unique(scr$borough)),\n",
    "      selected = \"All\"\n",
    "    ),\n",
    "    dateRangeInput(\"date_range\", \"Date Range:\",\n",
    "      start = min(scr$report_date),\n",
    "      end   = max(scr$report_date)\n",
    "    )\n",
    "  ),\n",
    "\n",
    "  dashboardBody(\n",
    "    tabItems(\n",
    "\n",
    "      # TAB 1: Borough Analysis\n",
    "      tabItem(tabName = \"borough\",\n",
    "        fluidRow(\n",
    "          valueBoxOutput(\"total_reports\"),\n",
    "          valueBoxOutput(\"subst_rate\"),\n",
    "          valueBoxOutput(\"top_allegation\")\n",
    "        ),\n",
    "        fluidRow(\n",
    "          box(plotOutput(\"borough_bar\"),   width=6, title=\"Reports by Borough\"),\n",
    "          box(plotOutput(\"allegation_pie\"), width=6, title=\"Allegation Types\")\n",
    "        )\n",
    "      ),\n",
    "\n",
    "      # TAB 2: Reporter Analysis (ChildStat)\n",
    "      tabItem(tabName = \"reporter\",\n",
    "        fluidRow(\n",
    "          box(plotOutput(\"reporter_accuracy\"), width=8,\n",
    "              title=\"Reporter Accuracy by Type\"),\n",
    "          box(\n",
    "            sliderInput(\"min_reports\", \"Min reports to show:\", 1, 50, 10),\n",
    "            tableOutput(\"reporter_table\"),\n",
    "            width=4, title=\"Reporter Summary\"\n",
    "          )\n",
    "        )\n",
    "      ),\n",
    "\n",
    "      # TAB 3: Trends\n",
    "      tabItem(tabName = \"trends\",\n",
    "        fluidRow(\n",
    "          box(plotOutput(\"monthly_trend\"), width=12,\n",
    "              title=\"Monthly Report Volume\")\n",
    "        )\n",
    "      )\n",
    "    )\n",
    "  )\n",
    ")\n",
    "\n",
    "# ─── SERVER ───────────────────────────────────────────────────\n",
    "server <- function(input, output, session) {\n",
    "\n",
    "  # Reactive filtered data — updates when any filter changes\n",
    "  filtered <- reactive({\n",
    "    d <- scr %>%\n",
    "      filter(report_date >= input$date_range[1],\n",
    "             report_date <= input$date_range[2])\n",
    "    if(input$borough_filter != \"All\")\n",
    "      d <- d %>% filter(borough == input$borough_filter)\n",
    "    d\n",
    "  })\n",
    "\n",
    "  # VALUE BOXES\n",
    "  output$total_reports <- renderValueBox({\n",
    "    valueBox(nrow(filtered()), \"Total Reports\",\n",
    "             icon=icon(\"file\"), color=\"blue\")\n",
    "  })\n",
    "\n",
    "  output$subst_rate <- renderValueBox({\n",
    "    rate <- round(mean(filtered()$is_substantiated, na.rm=TRUE)*100, 1)\n",
    "    valueBox(paste0(rate,\"%\"), \"Substantiation Rate\",\n",
    "             icon=icon(\"check\"), color=\"green\")\n",
    "  })\n",
    "\n",
    "  output$top_allegation <- renderValueBox({\n",
    "    top <- filtered() %>% count(allegation_type) %>%\n",
    "      slice_max(n, n=1) %>% pull(allegation_type)\n",
    "    valueBox(str_trunc(top,20), \"Top Allegation Type\",\n",
    "             icon=icon(\"exclamation\"), color=\"red\")\n",
    "  })\n",
    "\n",
    "  # BOROUGH BAR CHART\n",
    "  output$borough_bar <- renderPlot({\n",
    "    filtered() %>%\n",
    "      count(borough) %>%\n",
    "      mutate(borough = fct_reorder(borough, n)) %>%\n",
    "      ggplot(aes(x=borough, y=n, fill=borough)) +\n",
    "      geom_col(show.legend=FALSE) +\n",
    "      coord_flip() +\n",
    "      theme_minimal() +\n",
    "      labs(x=NULL, y=\"Reports\")\n",
    "  })\n",
    "\n",
    "  # REPORTER ACCURACY\n",
    "  output$reporter_accuracy <- renderPlot({\n",
    "    filtered() %>%\n",
    "      group_by(reporter_type) %>%\n",
    "      summarise(n=n(), rate=mean(is_substantiated,na.rm=TRUE)*100) %>%\n",
    "      filter(n >= input$min_reports) %>%\n",
    "      mutate(reporter_type=fct_reorder(reporter_type, rate)) %>%\n",
    "      ggplot(aes(x=reporter_type, y=rate, fill=rate)) +\n",
    "      geom_col(show.legend=FALSE) +\n",
    "      coord_flip() +\n",
    "      scale_fill_gradient(low=\"#FEE5D9\", high=\"#A50F15\") +\n",
    "      theme_minimal() +\n",
    "      labs(x=NULL, y=\"Substantiation Rate (%)\")\n",
    "  })\n",
    "\n",
    "  # MONTHLY TREND\n",
    "  output$monthly_trend <- renderPlot({\n",
    "    filtered() %>%\n",
    "      count(year_month) %>%\n",
    "      ggplot(aes(x=year_month, y=n)) +\n",
    "      geom_line(color=\"#2171B5\", linewidth=1) +\n",
    "      geom_smooth(method=\"loess\", se=TRUE, alpha=0.2, color=\"#CB181D\") +\n",
    "      theme_minimal() +\n",
    "      labs(x=NULL, y=\"Reports per Month\")\n",
    "  })\n",
    "}\n",
    "\n",
    "shinyApp(ui, server)\n",
    "'\n",
    "\n",
    "# Write the Shiny app to a file\n",
    "writeLines(shiny_app_code, 'acs_dashboard.R')\n",
    "cat('Shiny app saved to acs_dashboard.R\\n')\n",
    "cat('To run: shiny::runApp(\"acs_dashboard.R\")\\n')"
   ]
  },
